    {
      "name": "Tokens",
      "item": [
        {
          "name": "Create token (requires tokens:write)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.token) {",
                  "  pm.environment.set('restricted_token', json.data.token);",
                  "  console.log('Saved restricted_token for the 403 test.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Accept",        "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"read-only-partner\",\n  \"abilities\": [\"leads:read\"],\n  \"expires_at\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/tokens",
              "host": ["{{base_url}}"],
              "path": ["tokens"]
            }
          }
        }
      ]
    },
