              "raw": "{{base_url}}/campaigns-report?esp_id=1,2&date_from=2025-01-01&date_to=2025-12-31&search=jobs&sort_by=ctr&sort_dir=DESC",
              "host": ["{{base_url}}"],
              "path": ["campaigns-report"],
