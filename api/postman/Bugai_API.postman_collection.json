                { "key": "date_to",         "value": "", "disabled": true },
                { "key": "esp_id",          "value": "", "disabled": true },
                { "key": "search",          "value": "", "disabled": true },
                { "key": "template_id",     "value": "", "disabled": true },
                { "key": "esp_campaign_id", "value": "", "disabled": true },
                { "key": "weekday",         "value": "", "disabled": true }
              ]
            }
          }
        },
        {
